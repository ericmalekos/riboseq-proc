#!/usr/bin/env bash
# riboseq-proc: Ribo-seq reads to uniquely mapped, ncRNA-filtered BAMs with a 3-nt periodicity check.
#
#   riboseq-proc run     --sheet SHEET --run RUN [--stage prep|align|post|all]
#   riboseq-proc dataset --sheet SHEET --dataset DATASET [--par N]
#   riboseq-proc version
#
# Stages of one run (one row of the sample sheet, see README.md):
#   prep   raw checks on the first 1 M reads (3' adapter, modal length, SRA Lite quality signature), then one stream:
#          source [md5] -> umi_tools extract (optional) -> cutadapt adapter pass -> reverse complement (orient rev)
#          -> cutadapt pass 2 with the footprint length window -> bowtie2 --very-fast-local against the contaminant
#          index, unaligned reads kept.
#          Gate 2: modal length of the depleted reads inside the expected range.
#   align  STAR, unique mappers only (--outFilterMultimapNmax 1), end to end, at most 1 mismatch.
#   post   canonical chromosomes, drop reads over ncRNA loci, umi_tools dedup (optional), strand of the reads on
#          annotated CDSs, ribotish quality and the periodicity gate; BAM, QC tables and a done marker, uploaded
#          when OUT_REMOTE is set.
# "dataset" runs every row of one dataset, PAR runs at a time, each from prep to post with THREADS / PAR threads.
# The STAR index is loaded into shared memory once, every STAR run attaches to it, and it is removed when the
# command ends (SHARE_GENOME=0: each STAR run loads the index itself, one STAR at a time).
#
# Settings (environment): REF (reference bundle, default /ref) or its parts STARIDX, CONTAM, NCRNA_BED, QC_GTF,
# CHROMS; WORK (scratch), OUT (results), OUT_REMOTE (rclone remote path, optional), THREADS, PAR, KEEP_CLEAN=1,
# BAMSORT_RAM, SHARE_GENOME, NCRNA_FILTER (blocks: a read is dropped when one of its aligned blocks overlaps an
# ncRNA locus; span: when its whole alignment span does, introns included, as "samtools view -L" does), MAX_READS
# (test mode: only the first N reads of the source are processed and the md5 is not checked).
# Exit codes of "run": 0 done, 2 stopped by a data gate, 1 anything else.
set -euo pipefail
HEADER=$'dataset\trun\tsample\tcondition\tsource_type\tsource\tmd5\tadapter\tadapter_mode\torient\tumi\tpass2\tminlen\tmaxlen\texpect\tumi_dedup\trtlens\tminpct\tnotes'
NCOL=19

SELF=$(readlink -f "${BASH_SOURCE[0]}")
HERE=$(dirname "$SELF")
RP_VERSION=$(cat "$HERE/../VERSION" 2>/dev/null || echo unknown)
STAR_BIN=${STAR_BIN:-STAR}; CUTADAPT=${CUTADAPT:-cutadapt}; BOWTIE2=${BOWTIE2:-bowtie2}; SAMTOOLS=${SAMTOOLS:-samtools}
PIGZ_BIN=${PIGZ_BIN:-pigz}; RCLONE=${RCLONE:-rclone}; PYTHON=${PYTHON:-python3}; BEDTOOLS=${BEDTOOLS:-bedtools}
UMITOOLS=${UMITOOLS:-/opt/umitools/bin/umi_tools}; RIBOTISH=${RIBOTISH:-/opt/ribotish/bin/ribotish}
GATE=${GATE:-$HERE/periodicity_gate.py}
REF=${REF:-/ref}
STARIDX=${STARIDX:-$REF/star}; CONTAM=${CONTAM:-$REF/contam/contam}; NCRNA_BED=${NCRNA_BED:-$REF/ncrna.bed}
QC_GTF=${QC_GTF:-$REF/qc.gtf}; CHROMS=${CHROMS:-$REF/chroms.txt}
WORK=${WORK:-$PWD/work}; OUT=${OUT:-$PWD/results}; OUT_REMOTE=${OUT_REMOTE:-}
THREADS=${THREADS:-${NRP_CPUS:-${SLURM_CPUS_PER_TASK:-4}}}
PAR=${PAR:-1}; KEEP_CLEAN=${KEEP_CLEAN:-0}; BAMSORT_RAM=${BAMSORT_RAM:-4000000000}
NCRNA_FILTER=${NCRNA_FILTER:-blocks}; MAX_READS=${MAX_READS:-0}; SHARE_GENOME=${SHARE_GENOME:-1}
# set by "dataset" for its runs: how STAR gets the index, and a lock file when the index is not shared
GENOME_LOAD=${GENOME_LOAD:-NoSharedMemory}; STAR_LOCK=${STAR_LOCK:-}
export STAR_BIN CUTADAPT BOWTIE2 SAMTOOLS PIGZ_BIN RCLONE PYTHON BEDTOOLS UMITOOLS RIBOTISH GATE REF STARIDX CONTAM \
  NCRNA_BED QC_GTF CHROMS WORK OUT OUT_REMOTE PAR KEEP_CLEAN BAMSORT_RAM NCRNA_FILTER MAX_READS SHARE_GENOME \
  GENOME_LOAD STAR_LOCK PYTHONNOUSERSITE=1

ts() { date '+%F %T'; }
die() { echo "ABORT: $*" >&2; exit 1; }
say() { echo "[$(ts)] $*"; }

versions() {
  echo "riboseq-proc $RP_VERSION"
  echo "STAR $("$STAR_BIN" --version)"
  echo "cutadapt $("$CUTADAPT" --version)"
  "$BOWTIE2" --version 2>/dev/null | head -1 | sed 's#.*/##'
  "$SAMTOOLS" --version | head -1
  "$BEDTOOLS" --version
  "$UMITOOLS" --version 2>&1 | tail -1
  "$RIBOTISH" --version 2>&1 | tail -1
  echo "pigz $("$PIGZ_BIN" --version 2>&1 | awk '{print $NF}')"
  "$RCLONE" version 2>/dev/null | head -1 || echo "rclone not found"
}

# ---------------------------------------------------------------------------------------------------- sample sheet
check_sheet() {
  [[ -s "$SHEET" ]] || die "no sample sheet $SHEET"
  [[ "$(head -n 1 "$SHEET")" == "$HEADER" ]] || die "the header of $SHEET is not the expected $NCOL columns (README.md)"
}
load_row() {   # run -> row variables
  local run=$1 row n
  check_sheet
  n=$(awk -F'\t' -v r="$run" 'NR > 1 && $2 == r' "$SHEET" | wc -l)
  [[ "$n" -eq 1 ]] || die "run $run has $n rows in $SHEET"
  row=$(awk -F'\t' -v r="$run" 'NR > 1 && $2 == r' "$SHEET")
  awk -F'\t' -v n="$NCOL" '{if (NF != n) exit 1; for (i = 1; i <= NF; i++) if ($i == "") exit 1}' <<< "$row" \
    || die "the row of $run needs $NCOL non-empty fields (use - for none)"
  IFS=$'\t' read -r DS RUN SAMPLE COND STYPE SRC MD5 ADAPTER ADMODE ORIENT UMI PASS2 MINLEN MAXLEN EXPECT UMIDEDUP \
    RTLENS MINPCT NOTES <<< "$row"
  [[ "$DS" =~ ^[A-Za-z0-9._-]+$ && "$RUN" =~ ^[A-Za-z0-9._-]+$ ]] || die "dataset or run name with other characters than A-Za-z0-9._-"
  [[ "$STYPE" == fastq || "$STYPE" == rclone ]] || die "$RUN: source_type $STYPE (fastq or rclone)"
  [[ "$MD5" == - || "$MD5" =~ ^[0-9a-f]{32}$ ]] || die "$RUN: md5 $MD5"
  [[ "$ADAPTER" == - || "$ADAPTER" =~ ^[ACGTN]+$ ]] || die "$RUN: adapter $ADAPTER"
  [[ "$ADMODE" == require || "$ADMODE" == optional || "$ADMODE" == - ]] || die "$RUN: adapter_mode $ADMODE (require, optional or -)"
  [[ "$ADAPTER" == - || "$ADMODE" != - ]] || die "$RUN: an adapter needs adapter_mode require or optional"
  [[ "$ORIENT" == fwd || "$ORIENT" == rev ]] || die "$RUN: orient $ORIENT (fwd or rev)"
  [[ "$UMI" == - || "$UMI" == raw:?* || "$UMI" == trimmed:?* ]] || die "$RUN: umi $UMI (-, raw:<pattern> or trimmed:<pattern>)"
  [[ "$PASS2" == - || "$PASS2" =~ ^[A-Za-z0-9\ ,.=_+{}-]+$ ]] || die "$RUN: pass2 options with unexpected characters"
  [[ "$MINLEN" =~ ^[0-9]+$ && "$MAXLEN" =~ ^[0-9]+$ && "$EXPECT" =~ ^[0-9]+-[0-9]+$ ]] || die "$RUN: minlen, maxlen or expect"
  [[ "$UMIDEDUP" == yes || "$UMIDEDUP" == no ]] || die "$RUN: umi_dedup $UMIDEDUP (yes or no)"
  [[ "$UMIDEDUP" == no || "$UMI" != - ]] || die "$RUN: umi_dedup yes needs a umi pattern"
  [[ "$RTLENS" =~ ^[0-9]+,[0-9]+$ && "$MINPCT" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "$RUN: rtlens or minpct"
  S=$WORK/$DS/$RUN; Q=$OUT/$DS/qc; B=$OUT/$DS/bam
  STATUS=$OUT/$DS/status/$RUN.tsv; DONE=$OUT/$DS/done/$RUN.json
}
status() {   # stage, state, detail
  mkdir -p "$(dirname "$STATUS")"
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$(date -Iseconds)" >> "$STATUS"
  WROTE=$1
  say "status $RUN: $1 $2 $3"
}
last_state() {   # dataset, run -> stage:state of the last status line
  awk -F'\t' '{s = $1 ":" $2} END {print s}' "$OUT/$1/status/$2.tsv" 2>/dev/null || true
}
stop() {   # stage, state, detail, exit code: a recorded stop of this run
  status "$1" "$2" "$3"; exit "$4"
}

# ---------------------------------------------------------------------------------------------------- remote copy
upload_run() {   # what: qc (QC tables and status), bam (those and the BAM) or done (the done marker); copy, then compare checksums
  [[ -n "$OUT_REMOTE" ]] || return 0
  local -a inc=(--include "/qc/$RUN.*" --include "/status/$RUN.tsv")
  case "$1" in
    qc) ;;
    bam) inc+=(--include "/bam/$RUN.bam" --include "/bam/$RUN.bam.bai") ;;
    done) inc=(--include "/done/$RUN.json") ;;
    *) return 1 ;;
  esac
  "$RCLONE" copy "$OUT/$DS" "$OUT_REMOTE/$DS" "${inc[@]}" --transfers 4 --s3-chunk-size 64M \
    && "$RCLONE" check "$OUT/$DS" "$OUT_REMOTE/$DS" "${inc[@]}" --one-way
}

# ---------------------------------------------------------------------------------------------------- prep
raw_stream() { if [[ "$STYPE" == rclone ]]; then "$RCLONE" cat "$SRC"; else cat -- "$SRC"; fi; }
decomp() { if [[ "$SRC" == *.gz ]]; then "$PIGZ_BIN" -dc; else cat; fi; }
umi_extract() {   # pattern, log; a pattern with named groups is a regex, any other a 5' string pattern
  local method=string
  [[ "$1" != *'(?P<'* ]] || method=regex
  "$UMITOOLS" extract --extract-method="$method" --bc-pattern="$1" --log="$2"
}
umi_raw() { if [[ "$UMI" == raw:* ]]; then umi_extract "${UMI#raw:}" "$Q/$RUN.umi_extract.log"; else cat; fi; }
umi_trimmed() { if [[ "$UMI" == trimmed:* ]]; then umi_extract "${UMI#trimmed:}" "$Q/$RUN.umi_extract.log"; else cat; fi; }
adapter_pass() {
  if [[ "$ADAPTER" == - ]]; then cat; return; fi
  local -a o=(-a "$ADAPTER" -e 0.1 -O 3 -m 2)
  [[ "$ADMODE" != require ]] || o+=(--discard-untrimmed)     # a footprint read must reach the adapter
  "$CUTADAPT" -j "$CT" "${o[@]}" - 2> "$Q/$RUN.cutadapt_adapter.log"
}
limit_reads() { if (( MAX_READS > 0 )); then head -n $(( MAX_READS * 4 )); else cat; fi; }
revcomp() {   # orient rev: the read is the reverse complement of the footprint (for example read 2 of a pair)
  if [[ "$ORIENT" != rev ]]; then cat; return; fi
  "$PYTHON" -I -c '
import sys
t = bytes.maketrans(b"ACGTNacgtn", b"TGCANtgcan")
i, o = sys.stdin.buffer, sys.stdout.buffer
while True:
    h = i.readline()
    if not h:
        break
    s = i.readline().rstrip(b"\r\n")
    p = i.readline()
    q = i.readline().rstrip(b"\r\n")
    if len(s) != len(q):
        sys.exit("revcomp: sequence and quality lengths differ at " + h.decode(errors="replace").strip())
    o.write(h + s.translate(t)[::-1] + b"\n" + p + q[::-1] + b"\n")
'
}
pass2() {
  local -a o=()
  [[ "$PASS2" == - ]] || read -r -a o <<< "$PASS2"
  "$CUTADAPT" -j "$CT" ${o[@]+"${o[@]}"} -m "$MINLEN" -M "$MAXLEN" - 2> "$Q/$RUN.cutadapt_final.log"
}
count_line() { { grep -m 1 -E "$1" "$2" 2>/dev/null || true; } | sed 's/.*://' | tr -dc '0-9'; }

stage_prep() {
  STAGE=prep
  CT=$(( THREADS / 4 )); (( CT >= 1 )) || CT=1
  BT=$(( THREADS / 2 )); (( BT >= 1 )) || BT=1
  rm -rf "${S:?}"; mkdir -p "$S" "$Q"
  say "prep $DS $RUN: source=$STYPE:$SRC adapter=$ADAPTER ($ADMODE) orient=$ORIENT umi=$UMI pass2='$PASS2' window=$MINLEN-$MAXLEN max_reads=$MAX_READS threads=$THREADS host=$(hostname)"
  [[ "$STYPE" != fastq || -s "$SRC" ]] || die "missing $SRC"
  [[ -s "$CONTAM.1.bt2" || -s "$CONTAM.1.bt2l" ]] || die "no bowtie2 index $CONTAM"

  # 1. raw checks on the first 1 M reads (head closes the stream early, so pipefail is off here)
  local probe=AGATCGGAAGAGC
  [[ "$ADAPTER" == - ]] || probe=${ADAPTER:0:13}
  set +o pipefail
  raw_stream 2> "$S/probe.err" | decomp 2>> "$S/probe.err" | head -n 4000000 | awk -v run="$RUN" -v ad="$probe" '
    NR % 4 == 2 { n++; if (index($0, ad)) a++; if (index($0, "AGATCGGAAGAGC")) t++; L[length($0)]++ }
    NR % 4 == 0 { q = $0; c = substr(q, 1, 1); same = 1
                  for (i = 2; i <= length(q); i++) if (substr(q, i, 1) != c) { same = 0; break }
                  if (same) s[c]++ }
    END { m = 0; ml = 0; for (l in L) if (L[l] > m) { m = L[l]; ml = l }
          top = "-"; tm = 0; for (c in s) if (s[c] > tm) { tm = s[c]; top = c }
          d = (n > 0) ? n : 1
          printf "run\traw_checked\tprobe\tprobe_pct\ttruseq_pct\traw_modal_len\traw_modal_pct\tsingle_char_qual_pct\tsingle_char\n"
          printf "%s\t%d\t%s\t%.3f\t%.3f\t%d\t%.1f\t%.2f\t%s\n", run, n, ad, 100 * a / d, 100 * t / d, ml, 100 * m / d, 100 * tm / d, top }' \
    > "$Q/$RUN.raw_checks.tsv"
  set -o pipefail
  cat "$Q/$RUN.raw_checks.tsv"
  local nchk adpct trupct sqpct sqchr
  IFS=$'\t' read -r _ nchk _ adpct trupct _ _ sqpct sqchr < <(sed -n 2p "$Q/$RUN.raw_checks.tsv")
  if [[ "${nchk:-0}" -eq 0 ]]; then tail -n 5 "$S/probe.err" >&2 || true; die "no reads from $SRC"; fi
  if awk -v p="$sqpct" 'BEGIN {exit !(p > 50)}' && [[ "$sqchr" == "?" || "$sqchr" == "\$" ]]; then
    stop prep FAIL "SRA Lite signature: $sqpct% of reads carry the single quality '$sqchr'" 2
  fi
  if [[ "$ADAPTER" == - ]] && awk -v p="$trupct" 'BEGIN {exit !(p > 5)}'; then
    stop prep FAIL "$trupct% of raw reads contain AGATCGGAAGAGC but the sheet names no adapter" 2
  fi

  # 2. one stream from the source to the depleted reads; md5 of the source bytes and the trimmed length table are
  #    taken from the same stream through named pipes. With MAX_READS the stream is cut after that many reads: the
  #    steps before the cut then end with a broken pipe and the md5 covers only part of the file, so it is not checked.
  mkfifo "$S/md5.fifo" "$S/len.fifo"
  md5sum < "$S/md5.fifo" | cut -d' ' -f1 > "$S/raw.md5" &
  local p_md5=$!
  awk 'NR % 4 == 2 {L[length($0)]++} END {for (l in L) print l "\t" L[l]}' < "$S/len.fifo" | sort -k1,1n \
    > "$Q/$RUN.trim.lengths.tsv" &
  local p_len=$!
  local -a ps
  local i first=0 srcmd5
  set +e
  raw_stream | tee "$S/md5.fifo" | decomp | limit_reads | umi_raw | adapter_pass | revcomp | umi_trimmed | pass2 \
    | tee "$S/len.fifo" \
    | "$BOWTIE2" --very-fast-local -p "$BT" -x "$CONTAM" -U - --un-gz "$S/clean.fq.gz" -S /dev/null \
        2> "$Q/$RUN.bowtie2_contam.log"
  ps=("${PIPESTATUS[@]}")
  set -e
  wait "$p_md5"; wait "$p_len"
  rm -f "$S/md5.fifo" "$S/len.fifo"
  (( MAX_READS == 0 )) || first=3      # source, tee and decompression end with a broken pipe at the cut
  for (( i = first; i < ${#ps[@]}; i++ )); do
    (( ps[i] == 0 )) || die "the prep stream failed at step $(( i + 1 )) of ${#ps[@]} (exit statuses: ${ps[*]})"
  done
  srcmd5=$(cat "$S/raw.md5")
  if (( MAX_READS > 0 )); then
    srcmd5=not_checked_first_${MAX_READS}_reads
  elif [[ "$MD5" != - && "$srcmd5" != "$MD5" ]]; then
    rm -f "$S/clean.fq.gz"
    stop prep FAIL "md5 of the source ($srcmd5) is not the sheet's ($MD5)" 1
  fi
  [[ -s "$S/clean.fq.gz" ]] || die "bowtie2 wrote no unaligned reads"

  # 3. length table of the depleted reads; gate 2 on their modal length (the trimmed reads of an rRNA-rich library
  #    can peak on one rRNA fragment, so the mode before depletion says little about the footprints)
  "$PIGZ_BIN" -dc "$S/clean.fq.gz" | awk 'NR % 4 == 2 {L[length($0)]++} END {for (l in L) print l "\t" L[l]}' | sort -k1,1n \
    > "$Q/$RUN.clean.lengths.tsv"
  local modal tmodal ntrim nclean lo hi gate2 nin nraw cont
  read -r tmodal ntrim <<< "$(awk '{n += $2; if ($2 > m) {m = $2; ml = $1}} END {print ml + 0, n + 0}' "$Q/$RUN.trim.lengths.tsv")"
  read -r modal nclean <<< "$(awk '{n += $2; if ($2 > m) {m = $2; ml = $1}} END {print ml + 0, n + 0}' "$Q/$RUN.clean.lengths.tsv")"
  lo=${EXPECT%-*}; hi=${EXPECT#*-}
  if [[ "$ntrim" -eq 0 || "$nclean" -eq 0 ]]; then gate2=FAIL_empty
  elif (( modal >= lo && modal <= hi )); then gate2=PASS
  elif (( modal >= MAXLEN - 1 )); then gate2=FAIL_at_max_cap
  else gate2=WARN_modal_outside_expected; fi
  nin=$(count_line "Total reads processed" "$Q/$RUN.cutadapt_final.log")
  if [[ "$UMI" == raw:* ]]; then nraw=$(count_line "Input Reads" "$Q/$RUN.umi_extract.log")
  elif [[ "$ADAPTER" != - ]]; then nraw=$(count_line "Total reads processed" "$Q/$RUN.cutadapt_adapter.log")
  else nraw=$nin; fi
  cont=$(awk '/overall alignment rate/ {print $1}' "$Q/$RUN.bowtie2_contam.log")
  printf 'dataset\trun\tsample\tcondition\traw_reads\tpass2_input\ttrimmed_reads\tcontaminant_pct\tclean_reads\tmodal_trimmed_len\tmodal_clean_len\tgate2\tprobe_pct_raw\ttruseq_pct_raw\tsingle_char_qual_pct\tsource_md5\n%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$DS" "$RUN" "$SAMPLE" "$COND" "${nraw:-NA}" "${nin:-NA}" "$ntrim" "${cont:-NA}" "$nclean" "$tmodal" "$modal" "$gate2" \
    "$adpct" "$trupct" "$sqpct" "$srcmd5" > "$Q/$RUN.prep_summary.tsv"
  cat "$Q/$RUN.prep_summary.tsv"
  if [[ "$KEEP_CLEAN" == 1 ]]; then
    mkdir -p "$OUT/$DS/fastq_clean"
    cp "$S/clean.fq.gz" "$OUT/$DS/fastq_clean/$RUN.clean.fq.gz.tmp"
    mv "$OUT/$DS/fastq_clean/$RUN.clean.fq.gz.tmp" "$OUT/$DS/fastq_clean/$RUN.clean.fq.gz"
  fi
  if [[ "$gate2" == FAIL* ]]; then
    rm -f "$S/clean.fq.gz"
    stop prep GATE2_FAIL "modal length of the depleted reads $modal nt, expected $EXPECT ($gate2)" 2
  fi
  local note=""
  (( MAX_READS == 0 )) || note=", first $MAX_READS reads only"
  status prep OK "gate2 $gate2, modal $modal nt, $nclean clean reads$note"
}

# ---------------------------------------------------------------------------------------------------- align
stage_align() {
  STAGE=align
  [[ -s "$S/clean.fq.gz" ]] || die "no depleted reads for $RUN in $S (run the prep stage first)"
  [[ -s "$STARIDX/SA" ]] || die "no STAR index in $STARIDX"
  [[ "$GENOME_LOAD" == NoSharedMemory || "$GENOME_LOAD" == LoadAndKeep ]] \
    || die "GENOME_LOAD must be NoSharedMemory or LoadAndKeep, not $GENOME_LOAD"
  mkdir -p "$Q"
  say "align $DS $RUN: index=$STARIDX genome_load=$GENOME_LOAD threads=$THREADS host=$(hostname)"
  rm -rf "$S/STARtmp"
  local rc=0 why
  local -a lock=()
  [[ -z "$STAR_LOCK" ]] || lock=(flock "$STAR_LOCK")      # index not shared: one STAR holds it at a time
  ${lock[@]+"${lock[@]}"} "$STAR_BIN" --runMode alignReads --genomeDir "$STARIDX" --genomeLoad "$GENOME_LOAD" \
    --readFilesIn "$S/clean.fq.gz" --readFilesCommand zcat \
    --runThreadN "$THREADS" --alignEndsType EndToEnd --outFilterMultimapNmax 1 --outFilterMismatchNmax 1 \
    --outFilterIntronMotifs RemoveNoncanonicalUnannotated --outSAMattributes NH HI AS nM MD \
    --outSAMtype BAM SortedByCoordinate --limitBAMsortRAM "$BAMSORT_RAM" --outTmpDir "$S/STARtmp" \
    --outFileNamePrefix "$S/$RUN." > "$Q/$RUN.STAR.stdout.log" || rc=$?
  if (( rc != 0 )); then      # keep STAR's own message, for example the --limitBAMsortRAM it asks for
    cp "$S/$RUN.Log.out" "$Q/$RUN.STAR.Log.out" 2> /dev/null || true
    why=$({ grep -h -m 1 -A 2 'EXITING' "$Q/$RUN.STAR.stdout.log" "$Q/$RUN.STAR.Log.out" 2> /dev/null || true; } \
      | tr '\n\t' '  ' | cut -c1-300)
    stop align FAIL "STAR exit $rc: ${why:-see $RUN.STAR.Log.out}" 1
  fi
  [[ -s "$S/$RUN.Aligned.sortedByCoord.out.bam" ]] || die "STAR wrote no BAM"
  cp "$S/$RUN.Log.final.out" "$Q/$RUN.STAR.Log.final.out"
  cp "$S/$RUN.SJ.out.tab" "$Q/$RUN.SJ.out.tab"
  rm -rf "$S/STARtmp" "$S/clean.fq.gz"
  status align OK "$(awk -F'|' '/Uniquely mapped reads %/ {gsub(/[ \t]/, "", $2); print $2}' "$Q/$RUN.STAR.Log.final.out") unique"
}

# ---------------------------------------------------------------------------------------------------- post
cds_bed() {   # CDS intervals of QC_GTF merged per strand (BED6); built once per WORK and annotation file
  local key c
  key=$(printf '%s' "$(readlink -f "$QC_GTF"):$(stat -L -c '%s:%Y' "$QC_GTF")" | md5sum | cut -c1-12)
  c=$WORK/.riboseq-proc.cds.$key.bed
  if [[ ! -s "$c" ]]; then
    mkdir -p "$WORK"
    if [[ "$QC_GTF" == *.gz ]]; then "$PIGZ_BIN" -dc -- "$QC_GTF"; else cat -- "$QC_GTF"; fi \
      | awk -F'\t' -v OFS='\t' '$3 == "CDS" {print $1, $4 - 1, $5, ".", 0, $7}' | sort -k1,1 -k2,2n \
      | "$BEDTOOLS" merge -s -c 6 -o distinct -i - | awk -F'\t' -v OFS='\t' '{print $1, $2, $3, ".", 0, $4}' \
      > "$c.$$.tmp"
    [[ -s "$c.$$.tmp" ]] || die "no CDS records in $QC_GTF"
    mv "$c.$$.tmp" "$c"
  fi
  echo "$c"
}
stage_post() {
  STAGE=post
  local a=$S/$RUN.Aligned.sortedByCoord.out.bam t=$THREADS final
  [[ -s "$a" ]] || die "no STAR BAM for $RUN in $S (run the align stage first)"
  [[ -s "$NCRNA_BED" && -s "$CHROMS" && -s "$QC_GTF" ]] || die "missing $NCRNA_BED, $CHROMS or $QC_GTF"
  [[ "$NCRNA_FILTER" == blocks || "$NCRNA_FILTER" == span ]] || die "NCRNA_FILTER must be blocks or span, not $NCRNA_FILTER"
  mkdir -p "$Q" "$B" "$S/mpl"
  export MPLCONFIGDIR=$S/mpl MPLBACKEND=Agg
  say "post $DS $RUN: ncrna_filter=$NCRNA_FILTER umi_dedup=$UMIDEDUP rtlens=$RTLENS minpct=$MINPCT threads=$t host=$(hostname)"
  local -a chr
  mapfile -t chr < <(grep -v '^[[:space:]]*$' "$CHROMS")
  "$SAMTOOLS" index -@ "$t" "$a"
  "$SAMTOOLS" view -@ "$t" -b -o "$S/canon.bam" "$a" "${chr[@]}"
  "$SAMTOOLS" index -@ "$t" "$S/canon.bam"
  if [[ "$NCRNA_FILTER" == blocks ]]; then
    # -split tests the aligned blocks, so a read spliced across an intron that holds a snoRNA, a miRNA or a tRNA
    # is kept; the input order is kept as well
    "$BEDTOOLS" intersect -v -split -nonamecheck -abam "$S/canon.bam" -b "$NCRNA_BED" > "$S/clean.bam"
  else
    "$SAMTOOLS" view -@ "$t" -b -L "$NCRNA_BED" -U "$S/clean.bam" -o /dev/null "$S/canon.bam"
  fi
  "$SAMTOOLS" index -@ "$t" "$S/clean.bam"
  final=$S/clean.bam
  if [[ "$UMIDEDUP" == yes ]]; then
    "$UMITOOLS" dedup --stdin "$S/clean.bam" --stdout "$S/dedup.bam" --log "$Q/$RUN.umi_dedup.log"
    "$SAMTOOLS" index -@ "$t" "$S/dedup.bam"
    final=$S/dedup.bam
  fi
  "$SAMTOOLS" quickcheck "$final" || die "truncated BAM"
  local n_all n_can n_cln n_fin n_spl uniq input
  n_all=$("$SAMTOOLS" view -c -@ "$t" "$a")
  n_can=$("$SAMTOOLS" view -c -@ "$t" "$S/canon.bam")
  n_cln=$("$SAMTOOLS" view -c -@ "$t" "$S/clean.bam")
  n_fin=$("$SAMTOOLS" view -c -@ "$t" "$final")
  n_spl=$("$SAMTOOLS" view -@ "$t" "$final" | awk '$6 ~ /N/' | wc -l)

  # strand of the reads on annotated CDSs: a library that reads the antisense strand needs the other "orient"
  local cds n_se n_as se_pct strand
  cds=$(cds_bed)
  n_se=$("$BEDTOOLS" intersect -u -s -split -nonamecheck -ubam -abam "$final" -b "$cds" | "$SAMTOOLS" view -c -)
  n_as=$("$BEDTOOLS" intersect -u -S -split -nonamecheck -ubam -abam "$final" -b "$cds" | "$SAMTOOLS" view -c -)
  read -r se_pct strand <<< "$(awk -v s="$n_se" -v a="$n_as" 'BEGIN {
    if (s + a == 0) { print "NA none"; exit }
    p = 100 * s / (s + a); printf "%.1f %s\n", p, (p >= 80 ? "sense" : (p <= 20 ? "antisense" : "mixed")) }')"
  say "strand $RUN: $n_se reads on CDS sense, $n_as antisense ($se_pct% sense): $strand"

  # periodicity on annotated CDSs; a ribotish failure is a QC failure of the run, the BAM is still delivered
  local rt=0 verdict
  "$RIBOTISH" quality -b "$final" -g "$QC_GTF" -o "$Q/$RUN.qual.txt" -f "$Q/$RUN.qual.pdf" -r "$Q/$RUN.para.py" \
    --end3 -l "$RTLENS" -p "$t" > "$Q/$RUN.ribotish_quality.log" 2>&1 || rt=$?
  rm -f "$Q/$RUN.gate3.tsv"
  if [[ $rt -eq 0 && -s "$Q/$RUN.qual.txt" && -s "$Q/$RUN.para.py" ]]; then
    "$PYTHON" -I "$GATE" "$Q/$RUN.qual.txt" "$Q/$RUN.para.py" --label "$RUN" --min-pct "$MINPCT" \
      --tsv "$Q/$RUN.gate3.tsv" > "$Q/$RUN.gate3.txt" 2>&1 || true
    cat "$Q/$RUN.gate3.txt"
  else
    echo "ribotish quality exit $rt or no output; see $RUN.ribotish_quality.log" | tee "$Q/$RUN.gate3.txt"
  fi
  verdict=$(awk -F'\t' 'NR == 2 {print $2}' "$Q/$RUN.gate3.tsv" 2>/dev/null || true)
  verdict=${verdict:-FAIL_no_periodicity_output}

  cp "$final" "$B/$RUN.bam.tmp"; cp "$final.bai" "$B/$RUN.bam.bai.tmp"
  mv "$B/$RUN.bam.tmp" "$B/$RUN.bam"; mv "$B/$RUN.bam.bai.tmp" "$B/$RUN.bam.bai"
  uniq=$(awk -F'|' '/Uniquely mapped reads %/ {gsub(/[ \t]/, "", $2); print $2}' "$Q/$RUN.STAR.Log.final.out")
  input=$(awk -F'|' '/Number of input reads/ {gsub(/[ \t]/, "", $2); print $2}' "$Q/$RUN.STAR.Log.final.out")
  printf 'dataset\trun\tsample\tcondition\tstar_input\tuniq_pct\tunique_aligned\tcanonical_chroms\tafter_ncrna\tfinal\tspliced_final\tgate3\tcds_sense\tcds_antisense\tcds_sense_pct\tstrand\n%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$DS" "$RUN" "$SAMPLE" "$COND" "$input" "$uniq" "$n_all" "$n_can" "$n_cln" "$n_fin" "$n_spl" "$verdict" \
    "$n_se" "$n_as" "$se_pct" "$strand" > "$Q/$RUN.align_summary.tsv"
  cat "$Q/$RUN.align_summary.tsv"
  status post DONE "gate3 $verdict, strand $strand, $n_fin reads in the final BAM"
  mkdir -p "$(dirname "$DONE")"
  printf '{"dataset": "%s", "run": "%s", "gate3": "%s", "strand": "%s", "cds_sense_pct": "%s", "final_reads": %s, "bam_md5": "%s", "riboseq_proc": "%s", "star_index": "%s", "ncrna_filter": "%s", "max_reads": %s, "finished": "%s"}\n' \
    "$DS" "$RUN" "$verdict" "$strand" "$se_pct" "$n_fin" "$(md5sum "$B/$RUN.bam" | cut -d' ' -f1)" "$RP_VERSION" \
    "$(basename "$STARIDX")" "$NCRNA_FILTER" "$MAX_READS" "$(date -Iseconds)" > "$DONE.tmp"
  mv "$DONE.tmp" "$DONE"
  rm -rf "${S:?}"
  if [[ -n "$OUT_REMOTE" ]]; then
    # the done marker goes last, so a marker in the remote means the BAM beside it was verified
    if upload_run bam && upload_run done; then
      rm -f "$B/$RUN.bam" "$B/$RUN.bam.bai"      # verified in the remote; node scratch is small
      say "uploaded $RUN to $OUT_REMOTE/$DS"
    else
      rm -f "$DONE"
      stop post FAIL "upload to $OUT_REMOTE/$DS failed or did not verify" 1
    fi
  fi
}

# ---------------------------------------------------------------------------------------------------- commands
on_exit() {
  local rc=$?
  trap - EXIT
  local p; for p in $(jobs -p); do kill "$p" 2>/dev/null || true; done
  if (( rc != 0 )); then
    [[ "$WROTE" == "$STAGE" ]] || status "$STAGE" FAIL "exit $rc, see the log" || true
    [[ -z "${S:-}" ]] || rm -f "$S/md5.fifo" "$S/len.fifo"
    upload_run qc > /dev/null 2>&1 || true
  fi
  exit "$rc"
}
cmd_run() {
  local stage=all run=""
  while (( $# )); do
    case "$1" in
      --sheet) SHEET=$2; shift 2 ;;
      --run) run=$2; shift 2 ;;
      --stage) stage=$2; shift 2 ;;
      *) die "run: unknown option $1" ;;
    esac
  done
  [[ -n "${SHEET:-}" && -n "$run" ]] || die "run needs --sheet and --run"
  [[ "$THREADS" =~ ^[0-9]+$ && "$THREADS" -ge 1 ]] || die "THREADS=$THREADS"
  [[ "$MAX_READS" =~ ^[0-9]+$ ]] || die "MAX_READS=$MAX_READS"
  load_row "$run"
  if [[ -s "$DONE" ]]; then say "SKIP $RUN: done marker $DONE"; exit 0; fi
  STAGE=$stage; WROTE=""
  trap on_exit EXIT
  case "$stage" in
    prep) stage_prep ;;
    align) stage_align ;;
    post) stage_post ;;
    all) stage_prep; stage_align; stage_post ;;
    *) die "stage $stage (prep, align, post or all)" ;;
  esac
  say "$stage finished for $RUN"
}
throttle() { while (( $(jobs -rp | wc -l) >= $1 )); do wait -n || true; done; }
genome_load() {   # the index goes into SysV shared memory once; STAR runs with --genomeLoad LoadAndKeep attach to it
  local t=$SECONDS
  GDIR=$WORK/.genome.$$
  mkdir -p "$GDIR"
  say "loading the STAR index $STARIDX into shared memory"
  if ! "$STAR_BIN" --genomeLoad LoadAndExit --genomeDir "$STARIDX" --outFileNamePrefix "$GDIR/load." \
      > "$GDIR/load.stdout" 2>&1; then
    tail -n 8 "$GDIR/load.stdout" "$GDIR/load.Log.out" >&2 || true
    die "the STAR index could not be loaded into shared memory (kernel.shmmax, kernel.shmall or the memory limit; SHARE_GENOME=0 runs without it)"
  fi
  GENOME_LOADED=1
  say "index loaded ($(( SECONDS - t )) s)"
}
genome_remove() {
  [[ "${GENOME_LOADED:-0}" == 1 ]] || return 0
  GENOME_LOADED=0
  if "$STAR_BIN" --genomeLoad Remove --genomeDir "$STARIDX" --outFileNamePrefix "$GDIR/remove." \
      > "$GDIR/remove.stdout" 2>&1; then
    say "index removed from shared memory"
  else
    say "WARNING: STAR did not remove the index from shared memory; 'ipcs -m' lists what is left"
  fi
  rm -rf "${GDIR:?}"
}
dataset_exit() {   # stop the runs that are still going (each is its own process group under setsid), then free the index
  local rc=$? p t
  local -a pids=()
  trap - EXIT TERM INT
  pids=($(jobs -p))
  for p in ${pids[@]+"${pids[@]}"}; do kill -TERM -- "-$p" 2> /dev/null || kill -TERM "$p" 2> /dev/null || true; done
  wait 2> /dev/null || true
  # the tools of a run (STAR, bowtie2) can outlive its shell for a moment, and the kernel frees the index only when
  # no process is attached to it: wait until each group is empty, at most 30 s, then SIGKILL what is left
  for p in ${pids[@]+"${pids[@]}"}; do
    t=0
    while kill -0 -- "-$p" 2> /dev/null && (( t < 30 )); do sleep 1; t=$((t + 1)); done
    kill -KILL -- "-$p" 2> /dev/null || true
  done
  genome_remove || true
  [[ -z "$STAR_LOCK" ]] || rm -f "$STAR_LOCK"
  exit "$rc"
}
cmd_dataset() {
  local ds="" run tp st t0 nfail=0 ngate=0 ndone=0 f
  local -a launch=()
  while (( $# )); do
    case "$1" in
      --sheet) SHEET=$2; shift 2 ;;
      --dataset) ds=$2; shift 2 ;;
      --par) PAR=$2; shift 2 ;;
      *) die "dataset: unknown option $1" ;;
    esac
  done
  [[ -n "${SHEET:-}" && -n "$ds" ]] || die "dataset needs --sheet and --dataset"
  [[ "$PAR" =~ ^[0-9]+$ && "$PAR" -ge 1 && "$THREADS" =~ ^[0-9]+$ && "$THREADS" -ge 1 ]] || die "PAR=$PAR THREADS=$THREADS"
  [[ "$MAX_READS" =~ ^[0-9]+$ ]] || die "MAX_READS=$MAX_READS"
  [[ "$SHARE_GENOME" == 0 || "$SHARE_GENOME" == 1 ]] || die "SHARE_GENOME=$SHARE_GENOME (0 or 1)"
  check_sheet
  local -a runs
  mapfile -t runs < <(awk -F'\t' -v d="$ds" 'NR > 1 && $1 == d {print $2}' "$SHEET")
  (( ${#runs[@]} > 0 )) || die "no rows of dataset $ds in $SHEET"
  [[ -s "$STARIDX/SA" ]] || die "no STAR index in $STARIDX"
  tp=$(( THREADS / PAR )); (( tp >= 1 )) || tp=1
  L=$OUT/$ds/logs; mkdir -p "$L" "$OUT/$ds/done" "$WORK"
  t0=$(date +%s)
  say "dataset $ds: ${#runs[@]} runs, $THREADS threads, $PAR runs at a time ($tp threads each), share_genome=$SHARE_GENOME; host=$(hostname)"
  versions | sed 's/^/  /'
  if [[ -n "$OUT_REMOTE" ]]; then    # runs finished by an earlier attempt are not repeated
    "$RCLONE" copy "$OUT_REMOTE/$ds/done" "$OUT/$ds/done"
    say "done markers found in $OUT_REMOTE/$ds: $(find "$OUT/$ds/done" -name '*.json' | wc -l)"
  fi
  GENOME_LOADED=0; STAR_LOCK=""
  trap dataset_exit EXIT
  trap 'exit 143' TERM
  trap 'exit 130' INT
  if [[ "$SHARE_GENOME" == 1 ]]; then
    genome_load
    GENOME_LOAD=LoadAndKeep
  else
    GENOME_LOAD=NoSharedMemory; STAR_LOCK=$WORK/.star.$$.lock
    : > "$STAR_LOCK"
  fi
  export GENOME_LOAD STAR_LOCK
  ! command -v setsid > /dev/null 2>&1 || launch=(setsid)
  for run in "${runs[@]}"; do
    [[ ! -s "$OUT/$ds/done/$run.json" ]] || continue
    THREADS=$tp ${launch[@]+"${launch[@]}"} "$SELF" run --sheet "$SHEET" --run "$run" --stage all > "$L/$run.log" 2>&1 &
    throttle "$PAR"
  done
  wait
  say "all runs ended ($(( $(date +%s) - t0 )) s)"
  genome_remove
  for f in prep_summary align_summary; do
    for run in "${runs[@]}"; do [[ ! -s "$OUT/$ds/qc/$run.$f.tsv" ]] || cat "$OUT/$ds/qc/$run.$f.tsv"; done \
      | awk 'NR == 1 || !/^dataset\t/' > "$OUT/$ds/$f.tsv"
  done
  printf 'run\tlast_stage\tstate\tdetail\n' > "$OUT/$ds/run_states.tsv"
  for run in "${runs[@]}"; do
    if [[ -s "$OUT/$ds/done/$run.json" ]]; then ndone=$((ndone + 1)); fi
    st=$(last_state "$ds" "$run")
    case "$st" in
      post:DONE) ;;
      prep:GATE2_FAIL) ngate=$((ngate + 1)) ;;
      *) [[ -s "$OUT/$ds/done/$run.json" ]] || nfail=$((nfail + 1)) ;;
    esac
    { awk -F'\t' -v r="$run" '{l = r "\t" $1 "\t" $2 "\t" $3} END {print l}' "$OUT/$ds/status/$run.tsv" 2>/dev/null \
        || true; } >> "$OUT/$ds/run_states.tsv"
  done
  cat "$OUT/$ds/run_states.tsv"
  if [[ -n "$OUT_REMOTE" ]]; then
    "$RCLONE" copy "$OUT/$ds" "$OUT_REMOTE/$ds" --include "/logs/**" --include "/*.tsv"
  fi
  say "dataset $ds: $ndone of ${#runs[@]} runs done, $ngate stopped at gate 2, $nfail failed; $(( $(date +%s) - t0 )) s"
  [[ $nfail -eq 0 ]] || exit 1
}

case "${1:-}" in
  run) shift; cmd_run "$@" ;;
  dataset) shift; cmd_dataset "$@" ;;
  version) versions ;;
  *) sed -n '2,27p' "$SELF" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
